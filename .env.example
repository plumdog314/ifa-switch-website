# ここには実際の値を書かないこと。実際の値は Vercel の Environment Variables（ローカルでは .env.local）に設定する。

# AIチャット
ANTHROPIC_API_KEY=

# ---- ライトプラン会員機能（docs/members-setup.md を参照） ----
# 会員クッキーの署名に使う秘密の文字列（32文字以上のランダムな値。例: openssl rand -base64 48）
MEMBER_COOKIE_SECRET=
# Stripe の制限付きキー（rk_live_...）。Checkout Sessions / Customers / Subscriptions の「読み取り」だけを許可したもの
STRIPE_SECRET_KEY=
# ライトプランの価格ID（月払い・年払い）をカンマ区切りで
LITE_PRICE_IDS=price_xxx_monthly,price_xxx_yearly
